{
  "name": "tui-invaders",
  "version": "0.3.0",
  "description": "Terminal Space Invaders built with OpenTUI. Pixel art ships, bosses, drops, high scores.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "exports": {
    ".": "./src/embed.ts",
    "./embed": "./src/embed.ts"
  },
  "bin": {
    "tui-invaders": "./bin/tui-invaders.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "tui",
    "terminal",
    "game",
    "space-invaders",
    "opentui",
    "opencode",
    "cli-game"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpeOginni/tui-invaders.git"
  },
  "homepage": "https://github.com/OpeOginni/tui-invaders#readme",
  "bugs": {
    "url": "https://github.com/OpeOginni/tui-invaders/issues"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "pack:dry": "bun publish --dry-run",
    "publish:dry": "bun publish --dry-run",
    "release": "bun publish",
    "prepublishOnly": "bun run check && bun test"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  }
}
